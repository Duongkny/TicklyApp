{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tickly Development",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "development"
      ],
      "env": {
        "TEMP": "${workspaceFolder}/.dart_tool/tickly-temp",
        "TMP": "${workspaceFolder}/.dart_tool/tickly-temp",
        "GRADLE_USER_HOME": "E:/GradleCache/tickly",
        "ANDROID_USER_HOME": "${workspaceFolder}/.dart_tool/android-user-home",
        "JAVA_TOOL_OPTIONS": "-Djava.io.tmpdir=E:/FlutterTemp"
      },
      "preLaunchTask": "Tickly: prepare Flutter temp"
    },
    {
      "name": "Tickly Production",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "production"
      ],
      "env": {
        "TEMP": "${workspaceFolder}/.dart_tool/tickly-temp",
        "TMP": "${workspaceFolder}/.dart_tool/tickly-temp",
        "GRADLE_USER_HOME": "E:/GradleCache/tickly",
        "ANDROID_USER_HOME": "${workspaceFolder}/.dart_tool/android-user-home",
        "JAVA_TOOL_OPTIONS": "-Djava.io.tmpdir=E:/FlutterTemp"
      },
      "preLaunchTask": "Tickly: prepare Flutter temp"
    }
  ]
}
